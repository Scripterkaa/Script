local function sendEmbed(options)
    local embed = {
        title       = options.title or "",
        description = options.description or "",
        color       = options.color or 0x5865F2,
        fields      = options.fields or {},
        footer      = options.footer and { text = options.footer } or nil,
        thumbnail   = options.thumbnail and { url = options.thumbnail } or nil,
        author      = options.author and { name = options.author } or nil,
        timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ"),
    }

    local payload = HttpService:JSONEncode({
        username   = options.username or "Roblox Bot",
        avatar_url = options.avatar_url or nil,
        embeds     = { embed },
    })

        -- รองรับหลาย executor (Synapse, KRNL, Fluxus ฯลฯ)
    local request = syn and syn.request
        or http and http.request
        or (typeof(request) == "function" and request)
        or nil

    if not request then
        warn("Executor ของคุณไม่รองรับ HTTP Request")
        return
    end

    local ok, res = pcall(request, {
        Url     = WEBHOOK_URL,
        Method  = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body    = payload,
    })

    if ok then
        print("ส่งสำเร็จ | Status:", res.StatusCode)
    else
        warn("ส่งไม่สำเร็จ:", res)
    end
end
local function fmtVal(n)
    if n >= 1e9 then return ("%.1fB"):format(n / 1e9)
    elseif n >= 1e6 then return ("%.1fM"):format(n / 1e6)
    elseif n >= 1e3 then return ("%.1fK"):format(n / 1e3)
    else return tostring(math.floor(n)) end
end

local function webhook(target,amount)
