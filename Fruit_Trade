    )
    tBtn.MouseButton1Click:Connect(function()
        local lid = id
        if isSelected then State.Selected[lid] = nil else State.Selected[lid] = true end
        refresh()
    end)
end

-- ── Refresh ───────────────────────────────────────────────────────────────────
local function clearList(list)
    for _, c in pairs(list:GetChildren()) do
        if not (c:IsA("UIListLayout") or c:IsA("UIPadding")) then c:Destroy() end
    end
end

refresh = function()
    local fruits = {}
    local function scan(container)
        if not container then return end
        for _, item in pairs(container:GetChildren()) do
            local id   = item:GetAttribute("Id")
            local name = item:GetAttribute("FruitName") or item:GetAttribute("Fruit")
            if id and name then
                local mut = item:GetAttribute("Mutation")
                fruits[#fruits + 1] = {
                    Id       = id,
                    Name     = name .. (mut and " [" .. mut .. "]" or ""),
                    Instance = item,
                    Value    = calcValue(item),
                }
            end
        end
    end
    scan(Backpack)
    scan(LocalPlayer.Character)

    local valid = {}
    for _, f in pairs(fruits) do valid[f.Id] = true end
    for id in pairs(State.Selected) do
        if not valid[id] then State.Selected[id] = nil end
    end

    table.sort(fruits, function(a, b) return a.Value > b.Value end)

    clearList(MainUI.List)
    clearList(SelUI.List)

    local mTotal, mCount, mIdx = 0, 0, 0
    local sTotal, sCount, sIdx = 0, 0, 0

    for _, data in pairs(fruits) do
        local v = data.Value * multiplier
        if State.Selected[data.Id] then
            sIdx = sIdx + 1; sTotal = sTotal + v; sCount = sCount + 1
            buildRow(SelUI.List, data, v, sIdx, true)
        else
            mIdx = mIdx + 1; mTotal = mTotal + v; mCount = mCount + 1
            buildRow(MainUI.List, data, v, mIdx, false)
        end
    end

    MainUI.CountLbl.Text = mCount .. " items"
    MainUI.TotalVal.Text = "$: " .. fmtVal(mTotal)
    SelUI.CountLbl.Text  = sCount .. " items"
    SelUI.TotalVal.Text  = "$: " .. fmtVal(sTotal)
end

-- ── Debounced refresh ─────────────────────────────────────────────────────────
local pending = false
local function debouncedRefresh()
    if pending then return end
    pending = true
    task.defer(function() pending = false; refresh() end)
end

-- ── Watchers ──────────────────────────────────────────────────────────────────
local function connectContainer(container)
    if not container then return end
    table.insert(State.Connections, container.ChildAdded:Connect(debouncedRefresh))
    table.insert(State.Connections, container.ChildRemoved:Connect(debouncedRefresh))
end

connectContainer(Backpack)
connectContainer(LocalPlayer.Character)
table.insert(State.Connections, LocalPlayer.CharacterAdded:Connect(function(c)
    connectContainer(c)
    debouncedRefresh()
end))

-- ── Inventory sync ────────────────────────────────────────────────────────────
local function trySync()
    local bgui = PlayerGui:FindFirstChild("BackpackGui")
    if not bgui then return end
    local function sync()
        local v = bgui.Enabled
        if MainUI.Panel and MainUI.Panel.Parent then MainUI.Panel.Visible = v end
        if SelUI.Panel  and SelUI.Panel.Parent  then SelUI.Panel.Visible  = v end
        if TLogPanel    and TLogPanel.Parent     then TLogPanel.Visible    = v and TLogPanel.Visible end
        if MultiPanel   and MultiPanel.Parent    then MultiPanel.Visible   = v end
    end
    table.insert(State.Connections, bgui:GetPropertyChangedSignal("Enabled"):Connect(sync))
    sync()
end

trySync()
table.insert(State.Connections, PlayerGui.ChildAdded:Connect(function(c)
    if c.Name == "BackpackGui" then task.wait(0.1); trySync() end
end))

-- ── Auto-refresh ──────────────────────────────────────────────────────────────
task.spawn(function()
    while ScreenGui.Parent do task.wait(5); refresh() end
end)

refresh()
