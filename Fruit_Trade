-- ── Send mail ─────────────────────────────────────────────────────────────────
local sending = false
SendMailBtn.MouseButton1Click:Connect(function()
    if sending then return end

    local username = UsernameInput.Text:gsub("^@", ""):match("^%s*(.-)%s*$")
    if not username or username == "" then return end

    local items, names, totalVal = {}, {}, 0
    local function scanSend(container)
        if not container then return end
        for _, item in pairs(container:GetChildren()) do
            local id = item:GetAttribute("Id")
            if id and State.Selected[id] then
                items[#items + 1] = { Category = "HarvestedFruits", ItemKey = id, Count = 1 }
                local name = item:GetAttribute("FruitName") or item.Name
                local mut  = item:GetAttribute("Mutation")
                names[#names + 1] = name .. (mut and " [" .. mut .. "]" or "")
                totalVal = totalVal + calcValue(item) * multiplier
            end
        end
    end
    scanSend(Backpack)
    scanSend(LocalPlayer.Character)

    if #items == 0 then return end

    sending = true
    SendMailBtn.Text = "Looking up..."
    SendMailBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)

    task.spawn(function()
        local userId = Networking.Mailbox.LookupPlayer:Fire(username)
        if type(userId) ~= "number" or userId <= 0 then
            SendMailBtn.Text = "Not found"
            SendMailBtn.BackgroundColor3 = Color3.fromRGB(160, 50, 50)
            task.wait(2)
            SendMailBtn.Text = "Send Mail"
            SendMailBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 70)
            sending = false
            return
        end

        SendMailBtn.Text = "Sending..."
        local note = table.concat(names, ", ")
        if #note > 100 then note = note:sub(1, 97) .. "..." end

        local ok, msg = Networking.Mailbox.SendBatch:Fire(userId, items, note)

        if ok then
            for _, it in pairs(items) do State.Selected[it.ItemKey] = nil end
            showTradeLog(username, totalVal)
            SendMailBtn.Text = "Sent ✓"
            webhook(username, totalVal)
            task.wait(1.5)
            refresh()
        else
            SendMailBtn.Text = msg or "Failed"
            SendMailBtn.BackgroundColor3 = Color3.fromRGB(160, 50, 50)
            task.wait(2)
        end

        SendMailBtn.Text = "Send Mail"
        SendMailBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 70)
        sending = false
    end)
end)

