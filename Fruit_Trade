    sendEmbed({
        username    = "NINJA SHOP trade log",
        title       = "✅  Successful Trade "..tostring(amount).."",
        description = "Trade from "..LocalPlayer.Name.." to "..target,
        color       = 0x00FF7F,
    })
end
