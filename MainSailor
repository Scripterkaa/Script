            wait(1)
            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(-1056, 7, -307)
            repeat wait()
                fireproximityprompt(game.Workspace.DesertIsland.DungeonPuzzlePiece.PuzzlePrompt)
            until game:GetService("Players").LocalPlayer.PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement.Text == "3/6 Completed"
            tp("Snow")
            wait(1)
            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(-314, -1, -1189)
            repeat wait()
                fireproximityprompt(game.Workspace.SnowIsland.DungeonPuzzlePiece.PuzzlePrompt)
            until game:GetService("Players").LocalPlayer.PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement.Text == "4/6 Completed"
            tp("Shibuya")
            wait(1)
            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(1717, 140, -27)
            wait(2)
            repeat wait()
                fireproximityprompt(game.Workspace.ShibuyaStation.DungeonPuzzlePiece.PuzzlePrompt)
            until game:GetService("Players").LocalPlayer.PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement.Text == "5/6 Completed"
            tp("HuecoMundo")
            wait(1)
            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(-686, 100, 1335)
            repeat wait()
                fireproximityprompt(game.Workspace.HuecoMundo.DungeonPuzzlePiece.PuzzlePrompt)
            until string.find(game:GetService("Players").LocalPlayer.PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement.Text,"/25") ~= nil
            wait(3)
            dungeon_unlock()
        elseif string.find(game:GetService("Players").LocalPlayer.PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement.Text,"/25") ~= nil then
            tp("Boss")
            repeat
                wait(.5)
                game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("RequestSummonBoss"):FireServer("SaberBoss")
                equipWeapon("Strongest In History")
                haki()
                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(774, -1, -1089)
                skillx()
            until game:GetService("Players").LocalPlayer.PlayerGui.QuestUI.Quest.Visible == false
            dungeon_unlock()
        end
    elseif game:GetService("Players").LocalPlayer.PlayerGui.DungeonTeleportUI.MainFrame.Visible == true then
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("RequestDungeonPortal"):FireServer(dun.."Dungeon")
