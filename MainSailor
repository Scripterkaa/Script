        fireproximityprompt(game.Workspace.ServiceNPCs.DungeonPortalsNPC.HumanoidRootPart.DungeonNPCPrompt) 
    until game:GetService("Players").LocalPlayer.PlayerGui.QuestUI.Quest.Visible == true or
