    local result
    game:GetService("ReplicatedStorage").Remotes.UpdateInventory.OnClientEvent:Connect(function(table,item)
        if table == "Items" then
            for i,v in pairs(item) do
                if v.name == itemname then
                    result = v.quantity or "0"
                end
            end
        end
    end)

    game:GetService("ReplicatedStorage").Remotes.RequestInventory:FireServer()
    task.wait(.5)
    if result == nil then
        result = 0
    end
    return result
end
function equipWeapon(toolName)
    pcall(function()
        if game.Workspace:FindFirstChild(game.Players.LocalPlayer.Name) ~= nil then
            local tool = game.Players.LocalPlayer.Backpack:FindFirstChild(toolName) or game.Players.LocalPlayer.Character:FindFirstChild(toolName)
            if tool then
                game.Players.LocalPlayer.Character.Humanoid:EquipTool(tool)
            end
        end
    end)
end

