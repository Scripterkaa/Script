    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(islands)
    repeat wait() until game.Workspace:FindFirstChild("HogyokuFragment"..num) ~= nil
    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = game.Workspace["HogyokuFragment"..num].CFrame
    wait(.5 + moretime)
    fireproximityprompt(game.Workspace["HogyokuFragment"..num].HogyokuCollectPrompt)
    wait(.5 + moretime)

end

