                fireproximityprompt(game.Workspace.JungleIsland.DungeonPuzzlePiece.PuzzlePrompt)
            until game:GetService("Players").LocalPlayer.PlayerGui.QuestUI.Quest.Quest.Holder.Content.QuestInfo.QuestRequirement.Text == "2/6 Completed"
