function equiprunes()
    local isequip = game:GetService("Players").LocalPlayer.PlayerGui.StatsPanelUI.MainFrame.Frame.Content.SideFrame.UserStats.RuneEquipped.StatName.Text
    if isequip ~= "Rune: Fortune Rune" then
        local args = {
            [1] = "Equip",
            [2] = "Fortune Rune"
        }

        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("EquipRune"):FireServer(unpack(args))
    end
end

function open_chest(rarity)
    local amount = getQty(rarity.." Chest")
    if amount == 0 then
        return
    elseif amount > 10000 then
        amount = 10000
    end
    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("UseItem"):FireServer("Use",rarity.." Chest",getQty(rarity.." Chest"),false)
end
function _dungeon()
    haki()
    for i,v in pairs(game.Workspace.NPCs:GetChildren()) do
        if game:GetService("Players").LocalPlayer.PlayerGui.DungeonUI.ReplayDungeonFrameVisibleOnlyWhenClearingDungeon.Visible == true then
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("DungeonWaveReplayVote"):FireServer("sponsor")
        end
        if string.find(v.Name,"Dungeon") ~= nil then
            if game.Players.LocalPlayer.Character.Humanoid.Health < (game.Players.LocalPlayer.Character.Humanoid.MaxHealth / 10) then
                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(-130, 14, -121)
                wait(2)
                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(237, 14, 86)
                wait(2)
                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(239, 15, -115)
                wait(2)
                return
            end
            if v.Humanoid.Health ~= 0 then
                equipWeapon("Strongest In History")
                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame
                skillx()
                checkrune()
                wait(2)
            end
            if _Rune == true then
                game.Players.LocalPlayer:Kick("Got Runes")
            end
        end
    end
end

function farmboss()
    wait(.5)
    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("RequestSummonBoss"):FireServer("SaberBoss")
    repeat wait()
        equipWeapon("Strongest In History")
        haki()
        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(774, -1, -1089)
        skillx()
        wait(.25)
    until game.Workspace.NPCs.SaberBoss.Humanoid.Health <= 0
end
function statsrr()
    local R = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("GetStatRerollData"):InvokeServer()
    if R.Stats.Luck.Rank ~= "Z" then
        local args = {
            [1] = {
                ["A"] = true,
                ["SSS"] = true,
                ["SS"] = true,
                ["S"] = true
            }
        }

        game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("StatRerollUpdateAutoSkip"):FireServer(unpack(args))
        local args = {
            [1] = "Luck"
        }

        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("RerollSingleStat"):InvokeServer(unpack(args))
    end
end
