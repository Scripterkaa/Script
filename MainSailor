function farm(islands,pos,mon,quets)
    pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(islands)
        game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer("repeatable")
        wait(.75)
        game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("QuestAccept"):FireServer("QuestNPC"..quets)
        repeat wait()
            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = pos
            equipWeapon("Strongest In History")
            skillx()
            if checktitle() then
                statsrr()
            end
            wait(.25)
        until   game.Workspace.NPCs[mon.."1"].Humanoid.Health == 0 and
                game.Workspace.NPCs[mon.."2"].Humanoid.Health == 0 and
                game.Workspace.NPCs[mon.."3"].Humanoid.Health == 0 and
                game.Workspace.NPCs[mon.."4"].Humanoid.Health == 0 and
                game.Workspace.NPCs[mon.."5"].Humanoid.Health == 0
    end)
end
function equipass()
    local RS = game:GetService("ReplicatedStorage")
    local getAccessoryRemote = RS:WaitForChild("Remotes"):WaitForChild("GetAccessoryEquipped")
    local equippedAccessories = getAccessoryRemote:InvokeServer()
    if equippedAccessories.Stats ~= "Divine Wheel" then
        local args = {
            [1] = "EquipStats",
            [2] = "Divine Wheel"
        }
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("EquipAccessory"):FireServer(unpack(args))
    end
end
