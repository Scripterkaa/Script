function tp(place)
    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer(place)
end
function checkrune()
    if _Rune == true then
        return
    end
    game:GetService("ReplicatedStorage").Remotes.UpdateInventory.OnClientEvent:Connect(function(table,item)
        if table == "Runes" then
            for i,v in pairs(item) do
                if i == "Fortune Rune" then
                    _Rune = true
                    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("LeaveDungeonPortal"):FireServer()
                end
            end
        end
    end)

    game:GetService("ReplicatedStorage").Remotes.RequestInventory:FireServer()
end

function checktitle()
    local titledata = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("GetTitlesData"):InvokeServer()

    local result = false
    for i,v in pairs(titledata) do
        if i == "unlocked" then
            for j,k in pairs(v) do
                if k == "Destiny Marked" then
                    result = true
                end
            end
        end
    end
    if result == true then
        game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("TitleEquip"):FireServer("Destiny Marked")
    end

    return result
end

function dungeon_unlock(dun)
    game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("QuestAbandon"):FireServer("DungeonUnlock")
    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer("Dungeon")
