function getQtyKM(itemname)
        local result
        game:GetService("ReplicatedStorage").Remotes.UpdateInventory.OnClientEvent:Connect(function(table,item)
            if table == "Items" then
                for i,v in pairs(item) do
                    if v.name == itemname then
                        local qty = tostring(v.quantity) or 0
                        result = qty
                        if #qty > 3 and #qty < 7 then
                            local str = string.sub(qty, 1,-4).."k"
                            result = str
                        end
                        if #qty >= 7 then
                            local str = string.sub(qty,1,-7).."."..string.sub(qty,2,3).."M"
                            result = str
                        end
                    end
                end
            end
        end)

        game:GetService("ReplicatedStorage").Remotes.RequestInventory:FireServer()
        task.wait(1)
        if result == nil then
            result = 0
        end
        return result
    end
