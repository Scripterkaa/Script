function haki()
    pcall(function()
        if game.Players.LocalPlayer.Character["Right Arm"].BrickColor.Name ~= "Really black" then
            game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("HakiRemote"):FireServer("Toggle")
        end
    end)
end
function equipWeapon(toolName)
    pcall(function()
        if game.Workspace:FindFirstChild(game.Players.LocalPlayer.Name) ~= nil then
            local tool = game.Players.LocalPlayer.Backpack:FindFirstChild(toolName) or game.Players.LocalPlayer.Character:FindFirstChild(toolName)
            if tool then
                game.Players.LocalPlayer.Character.Humanoid:EquipTool(tool)
            end
        end
    end)
end
function skill(which)
    pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("AbilitySystem"):WaitForChild("Remotes"):WaitForChild("RequestAbility"):FireServer(which)
    end)
end
function atk_spawnBoss(boss,workspacename)
    pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TeleportToPortal"):FireServer("Boss")
        repeat wait()
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("RequestSummonBoss"):FireServer(boss)
        until game.Workspace.NPCs:FindFirstChild(workspacename) ~= nil and game.Workspace.NPCs:WaitForChild(workspacename).Humanoid.Health ~= 0
        repeat
            Root.CFrame = game.Workspace.NPCs:WaitForChild(workspacename):WaitForChild("HumanoidRootPart").CFrame
            equipWeapon("Strongest In History")
            skill(2)
            wait()
        until game.Workspace.NPCs:WaitForChild(workspacename):WaitForChild("Humanoid").Health <= 0
        wait(3)
    end)
end
